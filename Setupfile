# Setupfile
# Edit this file before running make all.
# - Update name and email.
# - Delete any line for an app you do not want installed.
# - Keep or remove entire sections — nothing is mandatory.

# ── Identity ────────────────────────────────────────────────────────────────
name      "Your Name"                           # Git username
email     "your@email.com"                      # Git email
gitignore "linux,swift,xcode,macos,objective-c,visualstudiocode"

# ── Shell ────────────────────────────────────────────────────────────────────
plugin "zsh-syntax-highlighting" "https://github.com/zsh-users/zsh-syntax-highlighting"  # Syntax highlighting for Zsh
plugin "zsh-autosuggestions"     "https://github.com/zsh-users/zsh-autosuggestions"      # Fish-like autosuggestions
plugin "zsh-completions"         "https://github.com/zsh-users/zsh-completions"          # Additional completion definitions
plugin "powerlevel10k"           "https://github.com/romkatv/powerlevel10k"              # Powerlevel10k theme
brew   "wget"                                   # Download files from the web
brew   "nmap"                                   # Network exploration and port scanner
cask   "iterm2"                                 # Terminal emulator for macOS
cask   "font-meslo-for-powerline"               # Font with Powerline symbols

# ── Dev ──────────────────────────────────────────────────────────────────────
brew   "gitmoji"                                # Emoji commit messages CLI
cask   "fork"                                   # Git GUI client
cask   "visual-studio-code"                     # Code editor
cask   "postman"                                # API development and testing
brew   "nvm"                                    # Node Version Manager
brew   "ngrok"                                  # Secure tunnel to localhost
cask   "proxyman"                               # HTTP debugging proxy
pip    "virtualenv"                             # Python virtual environments

# ── Dev — Backend / DevOps ───────────────────────────────────────────────────
cask   "docker"                                 # Container platform
brew   "k9s"                                    # Kubernetes CLI dashboard
brew   "kubernetes-cli"                         # kubectl
brew   "helm"                                   # Kubernetes package manager
brew   "sops"                                   # Secrets encryption (Secrets OPerationS)
brew   "go"                                     # Go programming language
cask   "goland"                                 # Go IDE by JetBrains
brew   "awscli"                                 # AWS Command Line Interface
brew   "azure-cli"                              # Azure Command Line Interface
brew   "mongosh"                                # MongoDB shell
cask   "mongodb-compass"                        # MongoDB GUI
cask   "studio-3t"                              # MongoDB IDE

# ── Dev — iOS ────────────────────────────────────────────────────────────────
brew   "cocoapods"                              # iOS dependency manager (CocoaPods)
brew   "carthage"                               # iOS dependency manager (Carthage)
brew   "sqlite"                                 # SQLite command-line interface
cask   "dash"                                   # API documentation browser
cask   "android-studio"                         # Android development environment
run    pod setup                                # Initialize CocoaPods master repo

# ── Design ───────────────────────────────────────────────────────────────────
cask   "figma"                                  # UI/UX design tool
cask   "zeplin"                                 # Design handoff and collaboration

# ── Productivity ─────────────────────────────────────────────────────────────
brew   "bat"                                    # cat clone with syntax highlighting
cask   "appcleaner"                             # Fully uninstall apps
cask   "the-unarchiver"                         # Archive extraction utility
cask   "eul"                                    # System monitor for Mac
cask   "hiddenbar"                              # Hide menu bar items
cask   "time-out"                               # Break reminder app
cask   "microsoft-edge"                         # Web browser
cask   "google-chrome"                          # Web browser
cask   "brave-browser"                          # Privacy-focused web browser
cask   "notion"                                 # Notes, tasks, and databases
cask   "typora"                                 # Markdown editor

# ── Teamwork ─────────────────────────────────────────────────────────────────
cask   "zoom"                                   # Video conferencing
cask   "slack"                                  # Team communication
cask   "discord"                                # Community and gaming chat
cask   "telegram"                               # Messaging app
cask   "skype"                                  # Video and voice calls
cask   "microsoft-teams"                        # Enterprise collaboration

# ── Fun ──────────────────────────────────────────────────────────────────────
cask   "spotify"                                # Music streaming
cask   "vlc"                                    # Media player
cask   "tradingview"                            # Financial charting and analysis

# ── macOS Preferences ────────────────────────────────────────────────────────
# Format: preference "domain" "key -type value"
# Delete lines you don't want applied.
preference  "com.apple.driver.AppleBluetoothMultitouch.trackpad"  "TrackpadThreeFingerDrag -bool true"       # Enable three-finger drag
preference  "com.apple.AppleMultitouchTrackpad"                   "TrackpadThreeFingerDrag -bool true"       # Enable three-finger drag (built-in)
preference  "com.apple.driver.AppleBluetoothMultitouch.trackpad"  "Clicking -bool true"                     # Tap to click
preference  "com.apple.AppleMultitouchTrackpad"                   "Clicking -bool true"                     # Tap to click (built-in)
preference  "com.apple.dock"                                       "autohide -bool true"                     # Auto-hide the Dock
preference  "com.apple.dock"                                       "show-recents -bool false"                # Hide recent apps in Dock
preference  "com.apple.dock"                                       "minimize-to-application -bool true"      # Minimize windows into app icon
preference  "NSGlobalDomain"                                       "AppleShowAllExtensions -bool true"       # Always show file extensions
preference  "com.apple.finder"                                     "AppleShowAllFiles -bool true"            # Show hidden files
preference  "com.apple.finder"                                     "ShowStatusBar -bool true"                # Show status bar in Finder
preference  "com.apple.finder"                                     "ShowPathbar -bool true"                  # Show path bar in Finder
preference  "com.apple.Terminal"                                   "\"Default Window Settings\" -string Pro" # Terminal Pro theme
preference  "com.apple.Terminal"                                   "\"Startup Window Settings\" -string Pro" # Terminal Pro theme on startup
